{
	"name": "open-wire",
	"displayName": "OpenWire",
	"description": "Expose VS Code language models as an OpenAI-compatible REST API for agents and tools",
	"version": "0.4.0",
	"publisher": "lewiswigmore",
	"license": "MIT",
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/lewiswigmore/open-wire"
	},
	"engines": {
		"vscode": "^1.95.0"
	},
	"categories": [
		"AI",
		"Machine Learning",
		"Other"
	],
	"keywords": [
		"openai",
		"copilot",
		"ollama",
		"claude",
		"gemini",
		"llm",
		"api",
		"rest",
		"agent",
		"language-model",
		"ai",
		"proxy",
		"streaming",
		"localhost",
		"chat-completions"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"extensionDependencies": [
		"github.copilot-chat"
	],
	"contributes": {
		"commands": [
			{
				"command": "open-wire.startServer",
				"title": "OpenWire: Start Server"
			},
			{
				"command": "open-wire.stopServer",
				"title": "OpenWire: Stop Server"
			},
			{
				"command": "open-wire.restartServer",
				"title": "OpenWire: Restart Server"
			},
			{
				"command": "open-wire.toggleServer",
				"title": "OpenWire: Toggle Server"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "open-wire",
					"title": "OpenWire",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"open-wire": [
				{
					"type": "webview",
					"id": "open-wire.sidebar",
					"name": "Controls"
				}
			]
		},
		"configuration": {
			"title": "OpenWire",
			"properties": {
				"openWire.server.autoStart": {
					"type": "boolean",
					"default": true,
					"description": "Start the relay server when VS Code launches"
				},
				"openWire.server.host": {
					"type": "string",
					"default": "127.0.0.1",
					"description": "Host address to bind the server to"
				},
				"openWire.server.port": {
					"type": "number",
					"default": 3030,
					"description": "Port number for the relay server"
				},
				"openWire.server.apiKey": {
					"type": "string",
					"default": "change-me-openwire-key",
					"description": "Bearer token required for request authentication (set this to a unique local value)"
				},
				"openWire.server.corsAllowedOrigins": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"http://localhost",
						"http://127.0.0.1",
						"http://[::1]"
					],
					"description": "Allowed browser origins for CORS. Entries without ports allow any port for that host."
				},
				"openWire.server.defaultModel": {
					"type": "string",
					"default": "",
					"description": "Default model ID when none is specified in the request"
				},
				"openWire.server.defaultSystemPrompt": {
					"type": "string",
					"default": "",
					"description": "Prepend this system prompt when a request has no system message"
				},
				"openWire.server.maxConcurrentRequests": {
					"type": "number",
					"default": 4,
					"description": "Maximum number of concurrent requests"
				},
				"openWire.server.rateLimitPerMinute": {
					"type": "number",
					"default": 60,
					"description": "Maximum requests per minute"
				},
				"openWire.server.requestTimeoutSeconds": {
					"type": "number",
					"default": 300,
					"description": "Request timeout in seconds"
				},
				"openWire.server.enableLogging": {
					"type": "boolean",
					"default": false,
					"description": "Enable detailed logging to the output channel"
				},
				"openWire.server.strictParams": {
					"type": "boolean",
					"default": false,
					"description": "Reject requests containing parameters OpenWire cannot honour, instead of reporting them in the response"
				},
				"openWire.server.jsonModeMaxRetries": {
					"type": "integer",
					"default": 1,
					"minimum": 0,
					"maximum": 3,
					"description": "How many repair attempts to make when response_format requires JSON and the model returns something invalid"
				},
				"openWire.server.maxRequestBodyMb": {
					"type": "integer",
					"default": 10,
					"minimum": 1,
					"maximum": 100,
					"description": "Maximum request body size in mebibytes (MiB). Image inputs need considerably more than plain text."
				}
			}
		}
	},
	"scripts": {
		"build": "node esbuild.js",
		"watch": "node esbuild.js --watch",
		"vscode:prepublish": "node esbuild.js --production",
		"package": "vsce package",
		"lint": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"@types/vscode": "~1.95.0",
		"@vscode/vsce": "^3.9.1",
		"esbuild": "^0.28.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
